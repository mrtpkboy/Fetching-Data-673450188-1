generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique
  name        String
  email       String?
  major       String
  year        Int
  createdAt   DateTime @default(now())
}
